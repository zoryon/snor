{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snor",
  "version": "0.1.0",
  "identifier": "app.snor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Snor", "width": 1240, "height": 840,
      "minWidth": 760, "minHeight": 560, "center": true,
      "backgroundColor": "#f8f7f4", "decorations": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "shortDescription": "Uno spazio veloce per Claude Code", "category": "Productivity", "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
